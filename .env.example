# Copiar este archivo como ".env" para desarrollo local (en Railway, estas variables
# se configuran en la pestaña "Variables" del proyecto, no en un archivo).

# Contraseña única que pide la app para entrar (compartida con toda el área).
APP_PASSWORD=cambiar-esta-clave

# Texto secreto usado para firmar la sesión del navegador. Cualquier texto largo
# y aleatorio sirve; que no sea adivinable.
SESSION_SECRET=cambiar-este-texto-secreto-largo

# Cadena de conexión a la base de datos Postgres.
# En Railway, al agregar el addon de PostgreSQL, esta variable se crea sola.
DATABASE_URL=postgres://frigor_app:devpassword123@localhost:5432/frigor_rrhh

PORT=3000
